# Copy to .env.local (gitignored) and restart `npx expo start` after changing.
# By default the app uses the Ghoomo API deployed on Vercel. The client keys below are required
# for the real API (every request is signed, Api.md §0); the mock backend and the stub don't need them.

# false = built-in dummy data instead of the Ghoomo API (Api.md). Default: true.
EXPO_PUBLIC_USE_REAL_API=true

# Base URL of the Ghoomo API, including the /apis prefix. Default: https://www.ghoomyo.in/apis.
# For a local Next.js server or `npm run stub:api`, use http://localhost:3000/apis
# (Android emulator: http://10.0.2.2:3000/apis; physical device: your machine's LAN IP).
EXPO_PUBLIC_API_URL=https://www.ghoomyo.in/apis

# Client keys: the android / ios / web entries of the server's APP_CLIENT_KEYS. Built into the app,
# so rebuild the APK after changing them. Web is only for running the app in a browser (expo start --web).
EXPO_PUBLIC_ANDROID_APP_KEY=
EXPO_PUBLIC_IOS_APP_KEY=
EXPO_PUBLIC_WEB_APP_KEY=

# Android Google Maps key for the store map (read by app.config.js).
GOOGLE_MAPS_API_KEY=
