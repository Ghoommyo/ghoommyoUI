# Copy to .env.local (gitignored) and restart `npx expo start` after changing.

# true = use the Ghoomo backend APIs (Api.md); anything else = built-in dummy data.
EXPO_PUBLIC_USE_REAL_API=false

# Base URL of the Ghoomo API, including the /apis prefix.
# Android emulator: use http://10.0.2.2:3000/apis. Physical device: use your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000/apis

# Android Google Maps key for the store map (read by app.config.js).
GOOGLE_MAPS_API_KEY=
